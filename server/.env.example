# ============================================================
# New Navnath Electronics & Electricals — Server Environment
# Copy this file to .env and fill in your real values
# ============================================================

# --- MongoDB Connection ---
# Replace with your Atlas URI or local MongoDB URI
MONGO_URI=mongodb://localhost:27017/navnath_electronics
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/navnath_electronics?retryWrites=true&w=majority

# --- JWT Secret (change to a strong random string in production) ---
JWT_SECRET=navnath_super_secret_key_change_me_in_production

# --- Razorpay Payment Gateway ---
# Get these from https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# --- Server Port ---
PORT=5000

# --- Node Environment ---
NODE_ENV=development
