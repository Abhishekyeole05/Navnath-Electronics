PORT=5000
NODE_ENV=production
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# ========================================================
# Your Render frontend URL (set after deploying Static Site to Render)
# Example: https://navnath-electronics-frontend.onrender.com
# ========================================================
FRONTEND_URL=https://navnath-electronics-frontend.onrender.com

# ========================================================
# MongoDB Atlas Cloud Database Connection String
# Get this from: Atlas Dashboard → Connect → Connect your application
# ========================================================
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/navnath_electronics?retryWrites=true&w=majority

# ========================================================
# Optional Gmail SMTP Credentials for Live Password Reset Emails
# Use a Gmail App Password (not your normal password):
#   Google Account → Security → 2-Step Verification → App passwords
# ========================================================
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx

# ========================================================
# Optional Razorpay Payment Gateway (Leave blank for Demo Mode)
# ========================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
