PORT=5000
JWT_SECRET=navnath_super_secret_jwt_key_2026
FRONTEND_URL=http://localhost:5174

# ========================================================
# MongoDB Atlas Cloud Database Connection String
# Replace <username> and <password> with your MongoDB Atlas credentials
# Leave blank to use local in-memory store for zero-config execution
# ========================================================
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/navnath_electronics?retryWrites=true&w=majority

# ========================================================
# Optional Gmail SMTP Credentials for Live Password Reset Emails
# If left blank, dev mode generates & logs reset links directly
# ========================================================
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# ========================================================
# Optional Razorpay Payment Gateway (Leave blank for Demo Mode)
# ========================================================
